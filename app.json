{
  "expo": {
    "name": "FlexTrack",
    "slug": "flextrack",
    "owner": "yoga-family",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flextrack",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#085041"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flextrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#085041"
      },
      "package": "com.flextrack.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#085041"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc023ab6-f76d-4ada-b097-528fd61b0124"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cc023ab6-f76d-4ada-b097-528fd61b0124"
    }
  }
}
